node-compile-cache/
*.tsbuildinfo
.DS_Store
.brv/
.worktrees
# Session-local Claude Code state. The glob form matters: git does not descend into an
# ignored directory, so a negation under a bare `.claude/` can never take effect. What is
# tracked here is what a second person needs — the reusable workflows, and the commands
# that are for working ON this repository rather than for its users.
.claude/*
!.claude/commands/
!.claude/workflows/
data/

# Tools
.serena/

# Codex temp worktrees (lcm-cli-* intentionally NOT ignored — presence in repo root = bug)
lossless-codex-*/

# Scratch files
sensitive-patterns-test.txt
*.db
!data/

# Recall benchmark output (lcm bench — local only, never committed)
.lcm-bench*.json

# Superpowers local state
.superpowers/
.pebbles/

# Environment secrets
.env
dist/


# Summarizer eval bench (local only, never committed)
test/bench/corpus/
test/bench/results/
