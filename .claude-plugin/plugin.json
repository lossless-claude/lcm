{
  "name": "lcm",
  "version": "0.12.0",
  "description": "Lossless context management — DAG-based summarization that preserves every message",
  "author": {
    "name": "Pedro Almeida",
    "url": "https://github.com/ipedro"
  },
  "homepage": "https://lossless-claude.com",
  "repository": "https://github.com/lossless-claude/lcm",
  "license": "MIT",
  "keywords": [
    "context",
    "memory",
    "compaction",
    "summarization",
    "lcm"
  ],
  "userConfig": {
    "sessionSummarizerMaxOutputTokens": {
      "type": "number",
      "title": "Session summarizer output token cap",
      "description": "Maximum output tokens served by the session summarizer per session; 0 disables it.",
      "default": 50000
    }
  },
  "mcpServers": {
    "lcm": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bundle/mcp-server.js"
      ]
    }
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "compact",
              "--hook"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "restore"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "session-end"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "user-prompt"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "session-snapshot"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|AskUserQuestion|Bash|EnterPlanMode|ExitPlanMode|Read|Edit|Write|Glob|Grep|TaskCreate|TaskUpdate|Skill|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "post-tool"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bundle/lcm.js",
              "post-tool"
            ]
          }
        ]
      }
    ]
  }
}
