{
  "name": "@lossless-claude/lcm",
  "version": "0.11.0",
  "description": "Never lose context again. lossless-claude compresses Claude Code sessions into searchable memory — every message preserved, every insight remembered.",
  "type": "module",
  "main": "dist/src/memory/index.js",
  "exports": {
    ".": "./dist/src/memory/index.js"
  },
  "bin": {
    "lcm": "dist/bin/lcm.js"
  },
  "license": "MIT",
  "author": "Pedro Almeida (https://github.com/ipedro)",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "files": [
    "dist/",
    "mcp.mjs",
    "lcm.mjs",
    ".claude-plugin/",
    "skills/",
    "hooks/",
    "docs/agent-tools.md",
    "docs/configuration.md",
    "docs/hook-protocol.md",
    "docs/import.md",
    "docs/privacy.md",
    "docs/tag-schema.md",
    "docs/vscode-codex.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "mkdir -p dist/src/prompts && cp -r src/prompts/*.yaml dist/src/prompts/ && mkdir -p dist/src/connectors/templates && cp -r src/connectors/templates/. dist/src/connectors/templates/ && cp installer/setup.sh dist/installer/setup.sh && node scripts/write-build-id.mjs && sh scripts/sync-plugin-cache.sh",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "release:verify": "npm test && npm pack --dry-run",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "typecheck:hooks": "bash scripts/typecheck-hooks.sh",
    "check-manifest": "node scripts/check-manifest.mjs",
    "version-packages": "changeset version && node scripts/sync-versions.mjs",
    "check-docs": "node scripts/check-doc-claims.mjs",
    "check-agents": "python3 tools/self-consistency/checker.pyz --root ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sinclair/typebox": "0.34.48",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@changesets/cli": "^2.30.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": ">=22",
    "@types/safe-regex": "^1.1.6",
    "openai": "^6.32.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^6.32.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lossless-claude/lcm.git"
  },
  "homepage": "https://github.com/lossless-claude/lcm#readme",
  "bugs": {
    "url": "https://github.com/lossless-claude/lcm/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
